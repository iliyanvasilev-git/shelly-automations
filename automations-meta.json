  "fan": {
    "set": {
      "title": "Control fan",
      "params": {
        "mode": {
          "title": "Mode",
          "description": "Operation mode of the component. Range of values: manual, auto.",
          "form": {
            "value": "string",
            "formElement": "select",
            "label": "Mode",
            "options": [
              "manual",
              "auto"
            ],
            "defaultValue": "manual",
            "required": false
          }
        },
        "on": {
          "title": "Fan state",
          "description": "True for fan on, false otherwise. Required for mode=manual, should not be set for mode=auto.",
          "form": {
            "value": "boolean",
            "formElement": "radio",
            "label": "Fan state",
            "required": true
          }
        },
        "speed": {
          "title": "Speed",
          "description": "Fan speed for manual mode. Optional for mode=manual, should not be set for mode=auto. Boundaries [1, 100].",
          "form": {
            "value": "number",
            "formElement": "slider",
            "label": "Speed",
            "min": 1,
            "max": 100,
            "required": false
          }
        }
      }
    }
  },
